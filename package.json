{
  "name": "blog-ia-nodejs",
  "version": "1.0.0",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "db:migrate": "node --env-file=.env.local node_modules/postgrator-cli/index.js",
    "db:migrate:undo": "node --env-file=.env.local node_modules/postgrator-cli/index.js 0",
    "build": "docker build -t blog-ia-nodejs:latest .",
    "test": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:e2e": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "pnpm run env:setup && pnpm run infra:up && npm run db:migrate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@mastra/core": "^1.74.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.16",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postgrator-cli": "^10.0.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
